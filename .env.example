# Database (Homebrew local default — no password)
DATABASE_URL=postgres://banbunsi@localhost:5432/banbunsi?sslmode=disable

# API
API_ADDR=:8080
APP_ENV=development
APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=bb_session
SESSION_TTL_HOURS=168
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Owner seed (created on first boot if missing)
OWNER_EMAIL=owner@banbunsi.local
OWNER_PASSWORD=ChangeMeOwner1!
OWNER_NAME=BAN BUNSI Owner

# SMTP (Mailpit local). Leave empty to log verification links to console.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@banbunsi.local

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL=http://localhost:8080
